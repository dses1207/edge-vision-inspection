# ============================================================
# edgevision 環境設定
#
# ⚠️ 這裡的每一個變數都必須能一對一對應到 K8s：
#     Compose  environment / env_file
#     K8s      ConfigMap（一般設定）/ Secret（機密）
#
#     程式碼只讀環境變數，不讀檔案、不寫死 —— 這是無痛移轉的前提。
# ============================================================

# ── 專案 ────────────────────────────────────────────────
PROJECT_NAME=edgevision
TZ=Asia/Taipei

# ── MinIO（物件儲存）────────────────────────────────────
# ⚠️ 用服務名而非 localhost：Compose 與 K8s 都能解析
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=edgevision
MINIO_ROOT_PASSWORD=<改成你的密碼>
MINIO_SECURE=false
MINIO_CONSOLE_PORT=9001
MINIO_API_PORT=9000

# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=edgevision
POSTGRES_PASSWORD=<改成你的密碼>
POSTGRES_DB=edgevision
DATABASE_URL=postgresql://edgevision:<改成你的密碼>@postgres:5432/edgevision

# ── go2rtc（串流）───────────────────────────────────────
GO2RTC_API=http://go2rtc:1984
GO2RTC_RTSP=rtsp://go2rtc:8554

# ── Triton（推論）───────────────────────────────────────
TRITON_URL=triton:8000
TRITON_GRPC=triton:8001

# ── Redis（事件匯流排 / 通知）───────────────────────────
# ⚠️ 用服務名 redis:6379：Compose bridge 與 K8s 都能解析。
#    inference 走 host 網路，會在 compose 裡覆寫成 localhost:6379。
#    未來連 K8s 上獨立維護的 Redis：只改這一行 REDIS_URL，程式不動。
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
# 事件 stream 名稱（正式部署每支程式可各自命名，避免互相混流）
REDIS_STREAM=edgevision:events

# ── 相機（機密）─────────────────────────────────────────
# ⚠️ 實際帳密只放 .env，絕不進 Git
CAM_USER=<相機帳號>
CAM_PASS=<相機密碼>
CAM156_IP=<相機 IP>

# ── 相機與線路設定─────────────────────────────────
# runner 本機只存「身分」：線路 ID + 設定來源。相機資料一律用 LINE_ID 去拉。
LINE_ID=alpha_a
# ⚠️ 來源必須明確指定，沒有隱式 fallback：
#    file = 讀掛載的 JSON（過渡期）  api = 讀資料庫（正式路線）
CAMERA_SOURCE=file
# 站別名，決定跑哪套判定邏輯（對應 station.yaml 的 name）。無預設值。
STATION=zone_intrusion
# ⚠️ file 模式必填：舊 JSON 沒有這些欄位，而猜錯解析度會讓座標全錯且無症狀。
#    切成 api 之後這三項改由 DB 提供，可移除。
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_STREAM_PATH=/stream2

# ── 推論服務 ────────────────────────────────────────────
# file 模式下指定要跑哪幾台（api 模式由 DB 的 line_id 決定，此值忽略）
CAMERA_ID=cam156
INFERENCE_FPS=5
# mock | triton —— 決定用哪個 Predictor 實作
PREDICTOR=mock
MOCK_LATENCY_MS=60

# ── 推流 ────────────────────────────────────────────────
RESTREAM_ENABLED=true
RESTREAM_FPS=20
RESTREAM_BITRATE=2000000

# ── API ─────────────────────────────────────────────────
API_PORT=8080

# ⚠️ 正式前端獨立部署（不同 port/domain）時必須設定，否則瀏覽器
# 會擋掉所有 /api/* 呼叫。逗號分隔；"*" = 不限來源（推論與控制 API 都吃這個，見 edgevision/api/cors.py）。
# ⚠️ 開 OAuth（cookie 帶身分）後建議改回白名單：不限來源時任何網頁都能借使用者身分打寫入端點。
# 例：CORS_ORIGINS=http://192.0.2.30:3000,https://vision.example.com
CORS_ORIGINS=

# ── WebRTC（多前端連線的關鍵）──────────────────────────
# go2rtc 只把「主機在觀看端網段的內網 IP」當 WebRTC candidate。
# ⚠️ 一定要設成本機的實際內網 IP —— 留 stun 或自動偵測會丟出一堆
#    連不通的候選位址（公網/VPN/IPv6），前端 ICE 逐一超時 → 多台一起卡。
WEBRTC_IP=192.0.2.29

# ── 相機（機密，實際值放 .env，勿進版控）────────────────
CAM_USER=admin
CAM_PASS=change_me
CAM156_IP=192.0.2.102

# ══════════════════════════════════════════════════════════
# 第二階段：訓練鏈路
# ══════════════════════════════════════════════════════════

# ── ClearML（實驗記錄 + 模型 Registry）─────────────────────
# SDK 連線：服務名（Compose）↔ K8s Service 名
CLEARML_API_HOST=http://clearml-apiserver:8008
CLEARML_WEB_HOST=http://clearml-webserver:80
CLEARML_FILES_HOST=http://clearml-fileserver:8081
# ⚠️ 固定服務憑證（apiserver 用同一組建立系統帳號）。換成夠長的隨機字串。
CLEARML_API_ACCESS_KEY=<隨機 30 字元>
CLEARML_API_SECRET_KEY=<隨機 50 字元>
CLEARML_PROJECT=edgevision
# ⚠️ 非 AWS 端點要帶 host:port（ClearML 規則）
CLEARML_OUTPUT_URI=s3://minio:9000/experiments/
CLEARML_SERVER_VERSION=latest
CLEARML_ES_HEAP=1g
CLEARML_API_PORT=8008
CLEARML_FILES_PORT=8081
CLEARML_WEB_PORT=8180

# ── LakeFS（資料集版本控制；metadata 在 PG lakefs db，檔案在 MinIO datasets/）──
LAKEFS_ENDPOINT=http://lakefs:8000
LAKEFS_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
LAKEFS_SECRET_KEY=<隨機 40 字元>
LAKEFS_ENCRYPT_SECRET=<隨機 32 字元>
LAKEFS_VERSION=latest
LAKEFS_PORT=8010

# ── 控制 API / Orchestrator ────────────────────────────────
CONTROL_PORT=8090
TRAINER_IMAGE=edgevision/trainer:dev
# trainer 基底映像；NGC 拉不到時可改 nvcr.io/nvidia/tritonserver:24.09-py3 並設 TRAINER_INSTALL_TORCH=1
TRAINER_BASE_IMAGE=nvcr.io/nvidia/pytorch:24.09-py3
TRAINER_INSTALL_TORCH=0
# 外網不穩時：先在能上網的機器 pip download 到 repo 的 wheels/，再設 --no-index --find-links=/wheels
TRAINER_PIP_EXTRA=
TRITON_IMAGE=nvcr.io/nvidia/tritonserver:24.09-py3
# 訓練用哪幾張卡（空 = 全部；K8s 改成 resources.limits）
TRAIN_GPU_IDS=0
# 心跳逾時（秒）：超過且容器不在 → 標 failed
TASK_HEARTBEAT_TIMEOUT=1800
# 同時可執行的訓練任務數。單卡設 1（訓練吃滿 GPU，並行只會互相拖慢或 OOM）
TRAIN_MAX_CONCURRENT=1
# 工作區保留幾個任務份（更舊的只留 logs/）。0 = 不清理
TRAIN_KEEP_WORKSPACES=5
# finalize 是否用臨時 Triton 做 TensorRT 一致性（需 GPU）
TRT_PARITY=true
# 映像建置時記下的程式碼版本（血緣用）
GIT_COMMIT=unknown

# ── 身分驗證（OAuth 授權伺服器）─────────────────────────
# ⚠️ X-Actor header 是【自我宣告】，誰都能冒名。啟用後 actor 以 token 驗證過的 sub 為準。
#    sub 的格式是 CORP\\alice（含 domain 前綴），audit_log 存原值當正規識別
#    —— 不同網域的帳號可能撞名，只存短名會撞。
AUTH_ENABLED=false
AUTH_SERVER=https://auth.example.com
AUTH_AUDIENCE=edgevision_api
# 過渡期 true：沒有 token 時仍接受 X-Actor（既有腳本與測試不會一次全壞）。
# 收緊時改 false，沒 token 一律 401。
AUTH_ALLOW_HEADER_ACTOR=true
# 授權伺服器用自簽憑證時設 false；正式憑證請設 true
AUTH_VERIFY_TLS=false
# JWKS 快取存活秒數（憑證輪替時自動重抓，不必重啟服務）
AUTH_JWKS_TTL_S=3600

# ── 遠端 MCP server ─────────────────────────────────────────
# 使用者貼的 URL 就是這個 + /mcp。⚠️ 換機器或上 K8s 要改（將來是 https://<ingress-host>）
MCP_PUBLIC_URL=http://localhost:8096
MCP_PORT=8096

# ── 24h 連續錄影 → NAS（profile: nas，預設不啟動）──────────
#
# ⚠️ NAS 必須在【起容器之前】掛好，否則錄影會寫進主機硬碟而不自知。
#    掛法（例：Synology 192.0.2.132 的 recordings 分享）：
#      sudo mkdir -p /mnt/nas
#      sudo mount -t cifs //192.0.2.132/recordings /mnt/nas \
#           -o credentials=/root/.nas-cred,vers=3.0,uid=1000,gid=1000
#    憑證檔 /root/.nas-cred（chmod 600）內容：
#      username=<帳號>
#      password=<密碼>
REC_NAS_MOUNT=/mnt/nas
REC_PROFILE=720p_h264
REC_SEGMENT_SECONDS=600
# 0 = 不自動刪，寫到滿（與舊系統一致）。滿了之後 REC_MIN_FREE_GB 會讓錄影停下來，
# 不會自動清舊檔 —— 要不要清是之後的決定。
REC_RETENTION_DAYS=0
# 低於這個空間就暫停錄影。這不是清理，是不讓 NAS 被寫到 100%
#（SMB 掛載寫滿會整個卡死，連帶拖垮其他用這個掛載點的東西）。
REC_MIN_FREE_GB=20
# ⚠️ 不要調低到 30：上游斷線時 ffmpeg 自己約 27~30 秒會退出，
#    門檻跟它賽跑會搶先砍掉行程，把乾淨重連變成沒有 moov 的壞檔。
REC_STALL_SECONDS=90
# 1 = /out 不是掛載點就拒絕啟動。只有在明知故犯時才設 0。
REC_REQUIRE_MOUNT=1

# ── 通知（Apprise）───────────────────────────────────────────
# 三組 URL 清單，分號隔開。通道是設定不是程式，加寄信只改這裡。
#   Teams：workflows://<host>/workflows/<id>/triggers/manual/paths/invoke?api-version=...&sig=...
#          （頻道 → 工作流程 → 「透過 Webhook 要求接收時張貼到頻道」。
#           ⚠️ 不是 msteams://，那是 2026-05 停用的舊 Incoming Webhook connector）
#   寄信：mailto://<帳號>:<密碼>@<smtp 主機>?to=ops@example.com
#   其他 100+ 種見 https://github.com/caronc/apprise/wiki
# 空 = 乾跑：整條鏈照跑、內容只印 log。測試機可以先空著。
NOTIFY_DAILY=
NOTIFY_HEALTH=
NOTIFY_NG=
NOTIFY_DAILY_AT=08:00
# 巡檢每 60 秒；同項目 10 分鐘冷卻；未恢復的 down 每 4 小時提醒
HEALTH_INTERVAL_S=60
HEALTH_COOLDOWN_S=600
HEALTH_REPEAT_S=14400
